{
  "run_dir": "runs/example_run",
  "agent_baseline": "prompt_design_agent.py",
  "source_prompt": "domains/prompt_design/prompt.md",
  "guidance": "domains/prompt_design/guidance.md",
  "evaluator_dir": "domains/prompt_design/evaluator",
  "evaluator": {
    "mode": "simple",
    "model": "hosted_vllm/gemma-4",
    "max_output_tokens": 16384
  },
  "models": {
    "meta_agent": "anthropic/claude-haiku-4-5-20251001",
    "prompt_design_task_agent": "hosted_vllm/gemma-4"
  },
  "agent_max_output_tokens": {
    "meta_agent": 4000,
    "prompt_design_task_agent": 4000
  },
  "agent_max_tool_calls": {
    "meta_agent": 8,
    "prompt_design_task_agent": 8
  },
  "loop": {
    "count": 3,
    "parent_selection": "score_child_prop",
    "stagnation_threshold": 80,
    "stagnation_window": 3,
    "stagnation_min_gain": 1
  },
  "model_token_limits": {
    "openai/gpt-5.6-luna": 4000000
  },
  "post_step": {
    "enabled": false,
    "script": null,
    "params": {}
  },
  "usage_log_path": "outputs/llm_usage.jsonl"
}
