# API key for the default Meta-Agent
ANTHROPIC_API_KEY=

# Optional: required only when OpenAI models are used
OPENAI_API_KEY=

# Optional: required only when Gemini models are used
GEMINI_API_KEY=

# Optional: explicit path to the local runtime config.
# Gemma/hosted_vllm is configured in hyperagent_config.json.
HYPERAGENT_CONFIG=hyperagent_config.json
